<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pulls reminders into the scheduler every half hour, at :05 and :35.

  Install:
    1. Edit the path in ProgramArguments below to where the script lives.
    2. cp com.odyssey.reminders-sync.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.odyssey.reminders-sync.plist

  StartCalendarInterval with only Minute set means "every hour at that
  minute". Two of them, half an hour apart, is how launchd says "every
  thirty minutes" while still landing on predictable clock times. There is
  a StartInterval key that takes plain seconds, but it counts from whenever
  the job was last loaded, so the run times drift and nobody can say when
  the next one is.

  Unlike cron, launchd DEFERS a run it missed rather than skipping it, and
  it coalesces several missed runs into one. So a Mac asleep overnight does
  a single catch-up run on wake, not eight.

  Twice an hour is cheap on purpose. The server drops reminders it has
  already imported BEFORE it sorts anything, so a run that finds nothing new
  makes no model call at all: it just reads the lists, posts them, and is
  told they are all duplicates. Roughly twelve seconds of the Mac doing
  nothing visible, which is the shape of almost every run.

  RunAtLoad is false so this does not fire on every login and every
  launchctl load on top of the hourly schedule.

  Output goes to the two files below so a run that failed can be read
  afterwards. They are in /tmp, which macOS clears on restart: fine for
  "why did that fail", not a permanent log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.odyssey.reminders-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- EDIT THIS to the real path on your Mac. -->
    <string>/Users/CHANGE_ME/reminders-sync/sync-reminders.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>35</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/odyssey-reminders-sync.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/odyssey-reminders-sync.err</string>
</dict>
</plist>
