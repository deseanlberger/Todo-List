# ---------------------------------------------------------------- storage
# Supabase. Leave unset to run on the built-in demo store: seeded, in memory,
# and gone when the process restarts. Everything in the app works either way;
# Settings tells you which one is live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The single user this app is built for. Must match the seeded rows in
# supabase/migrations/0001_init.sql.
APP_USER_ID=00000000-0000-0000-0000-000000000000

# --------------------------------------------------------------- calendar
# Google Calendar. Unset means the calendar adapter runs as a stub: it serves
# a realistic coaching week so the scheduler has walls to fill around, and
# accepts writes without pretending they went anywhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# The prefix on every event this app writes, so its blocks are visually
# distinct from real appointments and safe to bulk-delete on a re-run.
GCAL_EVENT_PREFIX="[ODY] "

# Everything is computed in this zone.
APP_TIME_ZONE=America/Los_Angeles

# ---------------------------------------------------------------- capture
# Claude parses captured messages into structured tasks. Unset falls back to
# a keyword parser, which still gets the task into the backlog.
ANTHROPIC_API_KEY=

# Telegram bot. Unset means /api/telegram returns 503.
TELEGRAM_BOT_TOKEN=
# Echoed by Telegram in x-telegram-bot-api-secret-token. Set it — without it
# anyone who finds the URL can post into the backlog.
TELEGRAM_WEBHOOK_SECRET=
# Where lead-time reminders are sent.
TELEGRAM_CHAT_ID=

# Voice transcription for voice notes. Any OpenAI-compatible transcription
# endpoint. Unset means the bot asks for text instead of dropping the note.
TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Guards GET /api/reminders, which the daily cron hits.
CRON_SECRET=
