# Supabase. Leave these unset to run the app on the built-in demo data layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The single user this app is built for. Any uuid; must match the seeded rows.
APP_USER_ID=00000000-0000-0000-0000-000000000000

# Google Calendar. Unset = the calendar adapter runs in stub mode and the
# scheduler sees an empty wall set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
